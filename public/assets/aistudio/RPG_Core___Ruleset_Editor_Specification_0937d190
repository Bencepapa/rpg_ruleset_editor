Instead of a heavy turn-by-turn UI replay, keep testing fast and focused:

    export interface BatchSimRequest {
      bundle: RulesetBundle;
      partyMembers: CharacterSheetState[];
      monsterIds: string[];              // e.g. ['orc_warrior', 'orc_warrior', 'giant_spider']
      iterations: number;                 // Default: 50
    }

    export interface BatchSimResult {
      iterations: number;
      elapsedMs: number;
      partyWins: number;
      partyLosses: number;
      winRatePercent: number;
      avgRounds: number;
      totalPartyDeaths: number;
      enemyMoraleBreaks: number;
    }

